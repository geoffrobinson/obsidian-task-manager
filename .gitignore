# vscode
.vscode 

# npm
node_modules

# Don't include the compiled main.js file in the repo root.
# Official builds are uploaded to GitHub releases instead.
# Personal fork builds under fork/ are tracked for BRAT/manual install.
/main.js
!fork/**/main.js

# Exclude sourcemaps
*.map

# Exclude macOS Finder (System Explorer) View States
.DS_Store

# Ignore local user AI rules
.claude
.cursorrules
.cursorignore
.github/copilot-instructions.md
AGENTS.md
CLAUDE.md
GEMINI.md

# Ignore local build script
scripts/build-local.sh

# Release lock file
.release.lock

# Web site
web/

# Obsidian
.obsidian
release-notes.md